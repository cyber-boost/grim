{
    "name": "grim-reaper/grim-reaper",
    "description": "Grim Reaper - Advanced backup, monitoring, and system management toolkit",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Grim Reaper Team",
            "email": "support@grim.so"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-curl": "*",
        "ext-openssl": "*",
        "ext-zip": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "psr-4": {
            "GrimReaper\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GrimReaper\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/grim"
    ],
    "scripts": {
        "post-install-cmd": [
            "GrimReaper\\Installer::postInstall"
        ],
        "post-update-cmd": [
            "GrimReaper\\Installer::postUpdate"
        ],
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-html coverage",
        "stan": "phpstan analyse src tests",
        "grim-install-deps": "GrimReaper\\Installer::installDependencies"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "version": "1.0.2",
    "extra": {
        "grim-reaper": {
            "description": "Advanced backup, monitoring, and system management toolkit with comprehensive PHP development features"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
} 