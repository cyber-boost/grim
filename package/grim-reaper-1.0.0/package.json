{
  "name": "grim-reaper",
  "version": "1.0.0",
  "description": "The Ultimate Backup, Monitoring, and Security System",
  "main": "scythe/scythe.py",
  "scripts": {
    "install": "./install/install.sh",
    "start": "systemctl start grim-backup grim-monitor grim-web",
    "stop": "systemctl stop grim-backup grim-monitor grim-web",
    "restart": "systemctl restart grim-backup grim-monitor grim-web",
    "status": "systemctl status grim-backup grim-monitor grim-web",
    "test": "python3 -m pytest tests/",
    "build": "./scripts/build.sh",
    "package": "./scripts/package.sh"
  },
  "keywords": [
    "backup",
    "monitoring",
    "security",
    "system-management",
    "orchestration",
    "compression",
    "api"
  ],
  "author": "Grim Reaper Development Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/grim-reaper/system.git"
  },
  "bugs": {
    "url": "https://github.com/grim-reaper/system/issues"
  },
  "homepage": "https://grim-reaper.org",
  "engines": {
    "node": ">=16.0.0",
    "python": ">=3.8.0",
    "go": ">=1.19.0"
  },
  "dependencies": {
    "python": {
      "flask": ">=2.0.0",
      "sqlalchemy": ">=1.4.0",
      "redis": ">=4.0.0",
      "psycopg2-binary": ">=2.9.0",
      "pyyaml": ">=6.0",
      "requests": ">=2.25.0",
      "cryptography": ">=3.4.0"
    },
    "go": {
      "github.com/gorilla/mux": ">=1.8.0",
      "github.com/go-redis/redis/v8": ">=8.11.0",
      "github.com/lib/pq": ">=1.10.0",
      "golang.org/x/crypto": ">=0.0.0-20210921155107-089bfa567519"
    },
    "system": {
      "postgresql": ">=13.0",
      "redis": ">=6.0",
      "nginx": ">=1.18.0",
      "docker": ">=20.10.0"
    }
  },
  "devDependencies": {
    "pytest": ">=6.0.0",
    "pytest-cov": ">=3.0.0",
    "black": ">=22.0.0",
    "flake8": ">=4.0.0"
  },
  "files": [
    "sh_grim/",
    "go_grim/",
    "py_grim/",
    "scythe/",
    "docs/",
    "config/",
    "scripts/",
    "install/",
    "README.md",
    "LICENSE"
  ],
  "directories": {
    "bin": "bin/",
    "lib": "lib/",
    "etc": "config/",
    "doc": "docs/",
    "scripts": "scripts/"
  },
  "config": {
    "install_dir": "/opt/grim-reaper",
    "config_dir": "/etc/grim-reaper",
    "log_dir": "/var/log/grim",
    "backup_dir": "/backups",
    "user": "grim",
    "group": "grim"
  },
  "metadata": {
    "build_date": "2024-07-18T13:30:00Z",
    "build_host": "grim-reaper-build-server",
    "git_commit": "abc123def456",
    "git_branch": "main",
    "checksum": "sha256:deadbeef1234567890abcdef1234567890abcdef1234567890abcdef1234567890"
  }
} 