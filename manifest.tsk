build_info:
    name: "Grim Reaper"
    version: "20250726_143227"
    build_date: "2025-07-26T14:32:29Z"
    build_host: "tuskone"
    build_user: "root"
    git_commit: "083f20a2fab3bc61471fdb0f5d2aa947492653cc"
    git_branch: "main"

components:
    reaper:
        description: "Backward compatibility layer and main entry point"
        main_script: "reaper.sh"
        features: [
            "environment_variables", "color_definitions", "utility_functions",
            "grim_throne_delegation", "legacy_script_support"
        ]
        status: "included"
    
    grim_throne:
        description: "Unified command router and CLI interface"
        main_script: "grim_throne.sh"
        status: "missing"
    
    bin:
        description: "Core binary utilities and API server"
        critical_files: [
            "tusk_parser.sh"
        ]
        notes: [
            "mother_api_server.sh is generated dynamically by scythe_mother.sh when API server starts"
        ]
        status: "included"
    
    modules:
        description: "Core functional modules and health check modules"
        critical_modules: [
            "herald.sh", "scribe.sh", "encrypt.sh", "dedup.sh", "remote.sh",
            "ai_integration.sh", "ai_decision_engine.sh", "ai_velocity_enhancer.sh",
            "multi_notify.sh", "schedule.sh", "healer.sh"
        ]
        health_modules: [
            "backup.sh", "restore.sh", "scan.sh", "delete.sh", "notify.sh",
            "monitor.sh", "health.sh", "schedule.sh", "compress.sh", "quarantine.sh"
        ]
        status: "included"
    
    sh_grim:
        description: "Bash operations engine with 60+ modules"
        modules: [
            "backup.sh", "restore.sh", "scan.sh", "monitor.sh", 
            "scythe.sh", "security.sh", "health.sh", "blacksmith.sh"
        ]
        status: "included"
    
    go_grim:
        description: "High-performance compression engine"
        binaries: [
            "build/grim-compression"
        ]
        status: "built"
    
    py_grim:
        description: "Python web services and APIs"
        modules: [
            "grim_web", "grim_core", "grim_monitor", "grim_gateway"
        ]
        status: "included"
    
    tsk_flask:
        description: "Flask-based admin web interface"
        main_script: "grim_admin_server.py"
        features: [
            "authentication", "command_execution", "static_file_serving",
            "ssl_support", "nginx_integration"
        ]
        status: "missing"
    
    scythe:
        description: "System orchestrator and coordinator"
        main_script: "scythe.py"
        status: "included"

system_requirements:
    python: ">=3.8"
    go: ">=1.19"
    node: ">=16"
    sqlite: ">=3.0"
    nginx: ">=1.18"

installation:
    method: "automated"
    installer: "./install.sh"
    full_installer: "./scripts/install.sh"
    target_directory: "/opt/reaper"
    requires_root: true

features:
    backup_system: true
    real_time_monitoring: true
    ai_integration: true
    web_interface: true
    admin_web_interface: "false"
    license_protection: true
    self_healing: true
    multi_language_sdk: false

checksums:
    md5: "992b532fe75f378866836f7970db245e"
    build_size: "31M"
    file_count: "1356"

deployment:
    nginx_config: "included"
    systemd_services: "auto-generated"
    database_setup: "automatic"
    dependencies: "auto-installed"

notes: [
    "Complete installation includes all dependencies",
    "Supports Ubuntu, Debian, CentOS, RHEL, Fedora",
    "Web interface available at http://localhost/",
    "API documentation at http://localhost/api/docs",
    "Admin interface available at http://localhost:4746/ (if tsk_flask included)",
    "Run 'grim health' to verify installation",
    "Optional: Setup admin interface with 'grim setup-admin'"
]
