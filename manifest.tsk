build_info:
    name: "Grim Reaper"
    version: "20250723_231638"
    build_date: "2025-07-23T23:16:40Z"
    build_host: "tuskone"
    build_user: "root"
    git_commit: "36f64641d999acdf25ee8f8298a1340e27966329"
    git_branch: "main"

components:
    grim_throne:
        description: "Unified command router and CLI interface"
        main_script: "grim_throne.sh"
        status: "included"
    
    sh_grim:
        description: "Bash operations engine with 60+ modules"
        modules: [
            "backup.sh", "restore.sh", "scan.sh", "monitor.sh", 
            "scythe.sh", "security.sh", "health.sh", "blacksmith.sh"
        ]
        status: "included"
    
    go_grim:
        description: "High-performance compression engine"
        binaries: [
            "build/grim-compression"
        ]
        status: "built"
    
    py_grim:
        description: "Python web services and APIs"
        modules: [
            "grim_web", "grim_core", "grim_monitor", "grim_gateway"
        ]
        status: "included"
    
    tsk_flask:
        description: "Flask-based admin web interface"
        main_script: "grim_admin_server.py"
        features: [
            "authentication", "command_execution", "static_file_serving",
            "ssl_support", "nginx_integration"
        ]
        status: "missing"
    
    scythe:
        description: "System orchestrator and coordinator"
        main_script: "scythe.py"
        status: "included"

system_requirements:
    python: ">=3.8"
    go: ">=1.19"
    node: ">=16"
    sqlite: ">=3.0"
    nginx: ">=1.18"

installation:
    method: "automated"
    installer: "./install.sh"
    full_installer: "./scripts/install.sh"
    target_directory: "/opt/reaper"
    requires_root: true

features:
    backup_system: true
    real_time_monitoring: true
    ai_integration: true
    web_interface: true
    admin_web_interface: "false"
    license_protection: true
    self_healing: true
    multi_language_sdk: false

checksums:
    md5: "9a1578d3af9759d60e2788b794478744"
    build_size: "12M"
    file_count: "172"

deployment:
    nginx_config: "included"
    systemd_services: "auto-generated"
    database_setup: "automatic"
    dependencies: "auto-installed"

notes: [
    "Complete installation includes all dependencies",
    "Supports Ubuntu, Debian, CentOS, RHEL, Fedora",
    "Web interface available at http://localhost/",
    "API documentation at http://localhost/api/docs",
    "Admin interface available at http://localhost:4746/ (if tsk_flask included)",
    "Run 'grim health' to verify installation",
    "Optional: Setup admin interface with 'grim setup-admin'"
]
