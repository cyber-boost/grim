{
  "name": "grim-reaper",
  "version": "1.0.33",
  "description": "Grim: Unified Data Protection Ecosystem. When data death comes knocking, Grim ensures resurrection is just a command away. License management, auto backups, highly compressed backups, multi-algorithm compression, content-based deduplication, smart storage tiering save up to 60% space, military-grade encryption, license protection, security surveillance, and automated threat response.",
  "main": "grim.js",
  "bin": {
    "grim": "grim.js"
  },
  "scripts": {
    "start": "node grim.js",
    "test": "node grim.js health",
    "build": "echo 'No build required for Node.js CLI'",
    "postinstall": "node scripts/postinstall.js || true",
    "install-global": "npm install -g .",
    "uninstall-global": "npm uninstall -g grim-js",
    "grim": "node grim.js"
  },
  "keywords": [
    "grim",
    "backup",
    "monitoring",
    "security",
    "cli",
    "orchestration",
    "system-management",
    "compression",
    "encryption",
    "ai",
    "machine-learning"
  ],
  "author": "Bernie Gengel and his beagle Buddy",
  "license": "SEE LICENSE IN https://grim.so/license",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cyber-boost/grim.git"
  },
  "bugs": {
    "url": "https://github.com/cyber-boost/grim/issues"
  },
  "homepage": "https://grim.so",
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^9.4.1",
    "ora": "^5.4.1",
    "inquirer": "^8.2.4",
    "figlet": "^1.5.2",
    "cli-table3": "^0.6.2",
    "dayjs": "^1.11.10",
    "node-cron": "^3.0.2",
    "node-fetch": "^3.3.2",
    "tar": "^6.2.1"
  },
  "devDependencies": {
    "jest": "^29.0.0",
    "eslint": "^8.0.0",
    "prettier": "^2.8.0"
  },
  "files": [
    "grim.js",
    "lib/grim-reaper.js",
    "lib/installer.js",
    "scripts/postinstall.js",
    "assets/grim-logo-primary.svg",
    "assets/grim-logo-icon.svg",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "directories": {
    "bin": "./",
    "lib": "./",
    "doc": "./docs",
    "scripts": "./scripts"
  },
  "config": {
    "install_dir": "/opt/grim-reaper",
    "config_dir": "/etc/grim-reaper",
    "log_dir": "/var/log/grim",
    "backup_dir": "/backups",
    "user": "grim",
    "group": "grim"
  },
  "metadata": {
    "build_date": "2025-01-27T17:30:00Z",
    "build_host": "grim-reaper-build-server",
    "git_commit": "abc123def456",
    "git_branch": "main",
    "checksum": "sha256:deadbeef1234567890abcdef1234567890abcdef1234567890abcdef1234567890"
  },
  "grim": {
    "version": "1.0.33",
    "components": {
      "sh_grim": "Bash-based backup and system operations",
      "scyth": "File scanning and analysis",
      "py_grim": "Python-based monitoring and AI",
      "go_grim": "Go-based web interface and performance"
    },
    "features": [
      "unified-cli",
      "multi-language-integration",
      "ascii-art",
      "backup-orchestration",
      "security-auditing",
      "ai-analysis",
      "system-monitoring",
      "web-interface",
      "emergency-operations"
    ],
    "legal": {
      "license": "https://grim.so/license",
      "privacy-policy": "https://grim.so/privacy-policy",
      "terms-and-conditions": "https://grim.so/terms-and-conditions"
    }
  }
}
