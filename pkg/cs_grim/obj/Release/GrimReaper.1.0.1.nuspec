<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2012/06/nuspec.xsd">
  <metadata>
    <id>GrimReaper</id>
    <version>1.0.1</version>
    <authors>Bernie Gengel and his beagle Buddy</authors>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <projectUrl>https://grim.so/</projectUrl>
    <description>When data death comes knocking, Grim ensures resurrection is just a command away. License management, auto backups, highly compressed backups, multi-algorithm compression, content-based deduplication, smart storage tiering save up to 60% space, military-grade encryption, license protection, security surveillance, and automated threat response.</description>
    <releaseNotes>Real core integration - no mock files! Directly calls actual sh_grim modules, go_grim binaries, and py_grim APIs.</releaseNotes>
    <copyright>Copyright © 2025 Bernie Gengel</copyright>
    <tags>backup monitoring security grim compression encryption deduplication license-protection</tags>
    <repository type="git" url="https://github.com/grim-reaper/grim" commit="93fab5d95e9c2f5cbb5ae0d37ed26abe13ed026d" />
    <dependencies>
      <group targetFramework="net8.0">
        <dependency id="Newtonsoft.Json" version="13.0.3" exclude="Build,Analyzers" />
        <dependency id="System.Text.Json" version="8.0.0" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
  <files>
    <file src="/opt/reaper/pkg/cs_grim/bin/Release/net8.0/GrimReaper.dll" target="lib/net8.0/GrimReaper.dll" />
    <file src="/opt/reaper/pkg/cs_grim/bin/Release/net8.0/GrimReaper.xml" target="lib/net8.0/GrimReaper.xml" />
  </files>
</package>