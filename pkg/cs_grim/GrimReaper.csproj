<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>GrimReaper</PackageId>
    <PackageVersion>1.0.35</PackageVersion>
    <Authors>Bernie Gengel and his beagle Buddy</Authors>
    <Company>Grim Reaper Systems</Company>
    <Product>Grim Reaper</Product>
    <Description>Death Defying Data Protection - When data death comes knocking, Grim ensures resurrection is just a command away. Comprehensive infrastructure monitoring with 200+ Flask routes across 7 domains, SSL certificate tracking, multi-service architecture with 5 backend services, enhanced package management with latest.tar.gz integration, professional tier system, real-time analytics, and production-ready monitoring dashboard.</Description>
    <PackageTags>backup;monitoring;security;grim;compression;encryption;deduplication;license-protection;emergency-recovery;networking;infrastructure-monitoring;ssl-tracking</PackageTags>
    <PackageProjectUrl>https://grim.so</PackageProjectUrl>
    <RepositoryUrl>https://github.com/cyber-boost/grim</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReleaseNotes>v1.0.35 MASSIVE INFRASTRUCTURE OVERHAUL: Comprehensive status monitoring with 200+ Flask routes, 7 domains with SSL tracking, multi-service architecture, enhanced package management with proper latest.tar.gz integration, environment variable setup (GRIM_ROOT, GRIM_LICENSE, GRIM_REAPER), sensitive data protection, cross-platform support, and production-ready monitoring dashboard. Real core integration!</PackageReleaseNotes>
    <Copyright>Copyright © 2025 Bernie Gengel</Copyright>
    <AssemblyVersion>1.0.35</AssemblyVersion>
    <FileVersion>1.0.35</FileVersion>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

</Project>