<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>GrimReaper</PackageId>
    <PackageVersion>1.0.33</PackageVersion>
    <Authors>Bernie Gengel and his beagle Buddy</Authors>
    <Company>Grim Reaper Systems</Company>
    <Product>Grim Reaper</Product>
    <Description>Death Defying Data Protection - When data death comes knocking, Grim ensures resurrection is just a command away. Emergency backup recovery system, animated installer (SKULLSTALL), advanced networking (G20), comprehensive download tracking, latest.tar.gz integration, military-grade encryption, multi-algorithm compression, content-based deduplication, and automated threat response.</Description>
    <PackageTags>backup;monitoring;security;grim;compression;encryption;deduplication;license-protection;emergency-recovery;networking;animated-installer</PackageTags>
    <PackageProjectUrl>https://grim.so</PackageProjectUrl>
    <RepositoryUrl>https://github.com/cyber-boost/grim</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReleaseNotes>v1.0.33 MASSIVE ARCHITECTURE REVAMP: Emergency backup recovery system operational, animated installer (SKULLSTALL) with 15-phase installation, advanced networking (G20) with SDN and load balancing, comprehensive download tracking analytics, latest.tar.gz integration. Real core integration - no mock files!</PackageReleaseNotes>
    <Copyright>Copyright © 2025 Bernie Gengel</Copyright>
    <AssemblyVersion>1.0.33.0</AssemblyVersion>
    <FileVersion>1.0.33.0</FileVersion>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

</Project>