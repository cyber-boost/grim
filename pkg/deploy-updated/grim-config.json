{
  "version": {
    "current": "2024.12.19",
    "override": null,
    "history": [
      {
        "version": "2024.12.19",
        "date": "2024-12-19T10:00:00Z",
        "notes": "Initial unified build/deploy system"
      }
    ]
  },
  "paths": {
    "base": "/opt/reaper/pkg",
    "logs": "/opt/reaper/pkg/logs"
  },
  "packages": {
    "js_grim": {
      "name": "grim-reaper",
      "enabled": true,
      "registry": "npm",
      "files": {
        "version": "package.json",
        "pattern": "\"version\": \"VERSION\""
      }
    },
    "py_grim": {
      "name": "grim-reaper", 
      "enabled": true,
      "registry": "pypi",
      "files": {
        "version": "setup.py",
        "pattern": "version='VERSION'"
      }
    },
    "rb_grim": {
      "name": "grim-reaper",
      "enabled": true,
      "registry": "rubygems",
      "files": {
        "version": "grim-reaper.gemspec",
        "pattern": "spec.version = 'VERSION'"
      }
    },
    "rs_grim": {
      "name": "grim-reaper",
      "enabled": true,
      "registry": "crates.io",
      "files": {
        "version": "Cargo.toml",
        "pattern": "version = \"VERSION\""
      }
    },
    "php_grim": {
      "name": "grim/reaper",
      "enabled": true,
      "registry": "packagist",
      "files": {
        "version": "composer.json",
        "json_field": "version"
      }
    },
    "go_grim": {
      "name": "github.com/cyber-boost/grim",
      "enabled": true,
      "registry": "pkg.go.dev",
      "files": {
        "version": "version.go",
        "content": "package grim_reaper\n\nconst Version = \"VERSION\""
      }
    },
    "cs_grim": {
      "name": "GrimReaper",
      "enabled": true,
      "registry": "nuget",
      "files": {
        "version": "GrimReaper.csproj",
        "pattern": "<Version>VERSION</Version>"
      }
    },
    "java_grim": {
      "name": "grim-reaper",
      "enabled": true,
      "registry": "maven",
      "files": {
        "version": "pom.xml",
        "pattern": "<version>VERSION</version>"
      }
    }
  },
  "deployment": {
    "order": ["js_grim", "rb_grim", "py_grim", "rs_grim", "php_grim", "go_grim", "cs_grim", "java_grim"],
    "credentials": {
      "npm": {
        "check_command": "npm whoami",
        "env_var": null,
        "file": null
      },
      "pypi": {
        "check_command": null,
        "env_var": "TWINE_USERNAME",
        "file": "~/.pypirc"
      },
      "rubygems": {
        "check_command": null,
        "env_var": null,
        "file": "~/.gem/credentials"
      },
      "crates.io": {
        "check_command": null,
        "env_var": null,
        "file": "~/.cargo/credentials.toml"
      },
      "nuget": {
        "check_command": null,
        "env_var": "NUGET_API_KEY",
        "file": null
      }
    }
  }
}