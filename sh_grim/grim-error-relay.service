[Unit]
Description=Grim Reaper Error Relay Daemon
Documentation=file:///opt/reaper/sh_grim/error_relay_daemon.sh
After=network.target
Wants=network-online.target

[Service]
Type=forking
User=root
Group=root
WorkingDirectory=/opt/reaper
Environment=GRIM_ROOT=/opt/reaper
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/opt/reaper/sh_grim/error_relay_daemon.sh start
ExecStop=/opt/reaper/sh_grim/error_relay_daemon.sh stop
ExecReload=/opt/reaper/sh_grim/error_relay_daemon.sh restart
PIDFile=/opt/reaper/tmp/error_relay_daemon.pid
Restart=always
RestartSec=30
TimeoutStartSec=60
TimeoutStopSec=30

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/reaper/logs /opt/reaper/tmp /opt/reaper/.graveyard
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=grim-error-relay

[Install]
WantedBy=multi-user.target