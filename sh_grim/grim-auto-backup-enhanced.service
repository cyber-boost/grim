[Unit]
Description=Grim Enhanced Auto-Backup System
Documentation=https://grim.so/docs/auto-backup
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/reaper
Environment=GRIM_ROOT=/opt/reaper
Environment=GRAVEYARD_DIR=/root/.graveyard
Environment=MONITOR_DIR=/opt/reaper
Environment=USER_TIER=FREE
Environment=BACKUP_INTERVAL=300
Environment=MAX_BACKUPS=50
Environment=COMPRESSION_ALGORITHM=zstd
ExecStart=/opt/reaper/sh_grim/auto_backup_enhanced.sh start
ExecStop=/opt/reaper/sh_grim/auto_backup_enhanced.sh stop
ExecReload=/opt/reaper/sh_grim/auto_backup_enhanced.sh restart
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=grim-auto-backup-enhanced

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/root/.graveyard /opt/reaper /var/log /var/run

# Resource limits
LimitNOFILE=65536
MemoryMax=512M
CPUQuota=50%

[Install]
WantedBy=multi-user.target 